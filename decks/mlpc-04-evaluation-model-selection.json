    },
    {
      "id": "mlpc-04-evaluation-model-selection-q14",
      "type": "single",
      "question": "When false negatives become much more expensive, which evaluation choice is most defensible?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Use accuracy only"
        },
        {
          "id": "B",
          "text": "Include the cost matrix or a cost-sensitive criterion"
        },
        {
          "id": "C",
          "text": "Ignore the minority class"
        },
        {
          "id": "D",
          "text": "Select the model with the most parameters"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Unequal error costs should enter evaluation or learning explicitly.",
      "tags": [
        "MLPC",
        "Cost-Sensitive Learning"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
