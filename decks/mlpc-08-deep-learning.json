    },
    {
      "id": "mlpc-08-deep-learning-q16",
      "type": "single",
      "question": "What is the standard first step when adapting a pretrained classifier to a new label set?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Replace its prediction head"
        },
        {
          "id": "B",
          "text": "Randomize all labels"
        },
        {
          "id": "C",
          "text": "Delete the feature extractor"
        },
        {
          "id": "D",
          "text": "Use the final test set as training data"
        }
      ],
      "correctOptions": [
        "A"
      ],
      "correctTextAnswer": "",
      "explanation": "Transfer learning commonly keeps useful early features and replaces the task-specific final layers.",
