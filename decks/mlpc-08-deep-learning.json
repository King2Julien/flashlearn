    {
      "id": "mlpc-08-deep-learning-q13",
      "type": "single",
      "question": "Why does data augmentation regularize an image classifier?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "It teaches invariance to label-preserving transformations"
        },
        {
          "id": "B",
          "text": "It permanently deletes hidden units"
        },
        {
          "id": "C",
          "text": "It reduces every image to one pixel"
        },
        {
          "id": "D",
          "text": "It uses the test set for training"
        }
      ],
      "correctOptions": [
        "A"
      ],
      "correctTextAnswer": "",
      "explanation": "Transformed training examples discourage reliance on irrelevant orientation, color, scale, or similar details.",
      "tags": [
        "MLPC",
        "Regularization"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
