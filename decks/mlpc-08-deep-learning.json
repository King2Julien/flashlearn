    },
    {
      "id": "mlpc-08-deep-learning-q14",
      "type": "single",
      "question": "What happens during dropout training?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "All weights are permanently removed"
        },
        {
          "id": "B",
          "text": "A random subset of hidden units is temporarily dropped for each example"
        },
        {
          "id": "C",
          "text": "The output classes are merged"
        },
        {
          "id": "D",
          "text": "The validation set is duplicated"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Dropout trains many overlapping subnetworks through temporary random deactivation.",
      "tags": [
        "MLPC",
        "Regularization"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
      "createdAt": "2026-06-12T00:00:00.000Z",
      "updatedAt": "2026-06-12T00:00:00.000Z"
    },
    {
      "id": "mlpc-08-deep-learning-q15",
      "type": "single",
      "question": "At test time with the lecture's dropout convention, what should happen?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Continue dropping half the units"
        },
        {
          "id": "B",
          "text": "Use all units without the training-time scale-up"
        },
        {
          "id": "C",
          "text": "Delete the output layer"
        },
        {
          "id": "D",
          "text": "Retrain from random weights"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "The described inverted compensation is applied during training; inference uses the complete network.",
      "tags": [
        "MLPC",
        "Regularization"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
