    {
      "id": "98dd3fe6-2d9b-4808-96d3-1185d651671d",
      "type": "single",
      "question": "Why does tanh contribute to vanishing gradients?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Its derivative can be very small"
        },
        {
          "id": "B",
          "text": "It scales its input linearly"
        },
        {
          "id": "C",
          "text": "It causes smaller loss values"
        },
        {
          "id": "D",
          "text": "Its derivative is 0 for any input x < 0"
