{
  "schemaVersion": 1,
  "id": "mlpc-10-unsupervised-learning",
  "title": "MLPC 10 - Unsupervised Learning and Clustering",
  "subject": "Machine Learning and Pattern Classification",
  "description": "Covers unsupervised learning, k-means, cluster model selection, BIC/MML, Gaussian mixture models, and EM. All questions are single-choice and modeled after the conceptual style of the MLPC Retry 2024S exam. Source: 10_Unsupervised_Learning.pdf.",
  "createdAt": "2026-06-12T00:00:00.000Z",
