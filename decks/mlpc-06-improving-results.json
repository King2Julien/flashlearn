    {
      "id": "mlpc-06-improving-results-q01",
      "type": "single",
      "question": "Why can removing irrelevant features improve k-NN?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "It changes labels into probabilities"
        },
        {
          "id": "B",
          "text": "Irrelevant dimensions can distort distances"
        },
        {
          "id": "C",
          "text": "k-NN requires exactly one feature"
        },
        {
          "id": "D",
          "text": "It makes every neighbour identical"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Distance-based classifiers can be strongly affected by irrelevant dimensions.",
      "tags": [
        "MLPC",
        "Feature Selection"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
      "createdAt": "2026-06-12T00:00:00.000Z",
      "updatedAt": "2026-06-12T00:00:00.000Z"
    },
    {
      "id": "mlpc-06-improving-results-q02",
      "type": "single",
      "question": "Why can removing redundant correlated features help Naive Bayes?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "It reduces violations of the independence assumption"
        },
        {
          "id": "B",
          "text": "It creates more classes"
        },
        {
          "id": "C",
          "text": "It forces nonlinear boundaries"
        },
        {
          "id": "D",
          "text": "It eliminates the need for priors"
        }
      ],
      "correctOptions": [
        "A"
      ],
      "correctTextAnswer": "",
      "explanation": "Duplicated or correlated evidence is problematic for a model that treats features as conditionally independent.",
      "tags": [
        "MLPC",
        "Feature Selection"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
      "createdAt": "2026-06-12T00:00:00.000Z",
      "updatedAt": "2026-06-12T00:00:00.000Z"
    },
    {
      "id": "mlpc-06-improving-results-q03",
      "type": "single",
      "question": "Why is exhaustive feature-subset search usually impractical for N features?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "There are only N possible subsets"
        },
        {
          "id": "B",
          "text": "The number of subsets grows on the order of 2^N"
        },
        {
          "id": "C",
          "text": "Cross-validation cannot compare subsets"
        },
        {
          "id": "D",
          "text": "Features cannot be removed"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Every feature can be included or excluded, yielding exponentially many subsets.",
      "tags": [
        "MLPC",
        "Feature Selection"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
      "createdAt": "2026-06-12T00:00:00.000Z",
      "updatedAt": "2026-06-12T00:00:00.000Z"
    },
    {
      "id": "mlpc-06-improving-results-q04",
      "type": "single",
      "question": "Forward feature selection starts with:",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "All features and removes the worst"
        },
        {
          "id": "B",
          "text": "An empty set and repeatedly adds the most useful feature"
        },
        {
          "id": "C",
          "text": "A random forest"
        },
        {
          "id": "D",
          "text": "The test set"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Forward selection greedily grows the selected subset from no features.",
      "tags": [
        "MLPC",
        "Feature Selection"
      ],
      "difficulty": "medium",
