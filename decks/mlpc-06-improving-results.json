    {
      "id": "mlpc-06-improving-results-q09",
      "type": "single",
      "question": "What distinguishes stacking from simple voting?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Stacking trains a meta-classifier from base-model predictions"
        },
        {
          "id": "B",
          "text": "Stacking uses no base models"
        },
        {
          "id": "C",
          "text": "Stacking requires all votes to be equal"
        },
        {
          "id": "D",
          "text": "Stacking only smooths temporal labels"
        }
      ],
      "correctOptions": [
        "A"
      ],
      "correctTextAnswer": "",
      "explanation": "The second-level model learns how to combine the base learners' outputs.",
      "tags": [
        "MLPC",
        "Ensemble Methods"
      ],
