    {
      "id": "mlpc-06-improving-results-q08",
      "type": "single",
      "question": "In bagging, each base learner is typically trained on:",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "The same single example"
        },
        {
          "id": "B",
          "text": "A bootstrap sample drawn with replacement"
        },
        {
          "id": "C",
          "text": "Only examples misclassified by the previous learner"
        },
        {
          "id": "D",
          "text": "The untouched final test set"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Bootstrap aggregation creates diverse training sets by sampling with replacement.",
      "tags": [
        "MLPC",
        "Ensemble Methods"
      ],
      "difficulty": "medium",
