    },
    {
      "id": "mlpc-06-improving-results-q10",
      "type": "single",
      "question": "In boosting, what happens to an example misclassified by the current classifier?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "It is permanently deleted"
        },
        {
          "id": "B",
          "text": "Its weight is increased for the next classifier"
        },
        {
          "id": "C",
          "text": "It becomes a test example"
        },
        {
          "id": "D",
          "text": "Its class is changed"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Boosting focuses subsequent learners on examples that earlier learners handled poorly.",
      "tags": [
        "MLPC",
        "Ensemble Methods"
      ],
      "difficulty": "medium",
      "source": "MLPC lecture slides SS 2026",
