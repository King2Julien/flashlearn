    {
      "id": "mlpc-06-improving-results-q06",
      "type": "single",
      "question": "How should a proposed new feature representation be evaluated?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Only by checking training accuracy"
        },
        {
          "id": "B",
          "text": "By mapping the data and estimating performance with a proper validation procedure such as cross-validation"
        },
        {
          "id": "C",
          "text": "By counting feature names"
        },
        {
          "id": "D",
          "text": "On the final test set repeatedly"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "Feature engineering is a model-selection decision and should be assessed without test leakage.",
