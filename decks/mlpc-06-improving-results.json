    {
      "id": "mlpc-06-improving-results-q05",
      "type": "single",
      "question": "A decision tree cannot easily identify squares from separate length and width features. Which constructed feature is most directly useful?",
      "code": "",
      "image": null,
      "options": [
        {
          "id": "A",
          "text": "Length + color"
        },
        {
          "id": "B",
          "text": "Length / width"
        },
        {
          "id": "C",
          "text": "A random identifier"
        },
        {
          "id": "D",
          "text": "The class label copied as a feature"
        }
      ],
      "correctOptions": [
        "B"
      ],
      "correctTextAnswer": "",
      "explanation": "The ratio directly expresses the relation needed to distinguish equal sides from unequal sides.",
      "tags": [
        "MLPC",
        "Feature Construction"
      ],
      "difficulty": "medium",
