      "options": [
        {
          "id": "A",
          "text": "Neighbourhood smoothing"
        },
        {
          "id": "B",
          "text": "Feature elimination"
        },
        {
          "id": "C",
          "text": "Bootstrap sampling"
        },
        {
          "id": "D",
          "text": "Kernel mapping"
        }
      ],
      "correctOptions": [
        "A"
      ],
      "correctTextAnswer": "",
      "explanation": "Smoothing uses nearby predicted labels to correct isolated implausible outputs.",
